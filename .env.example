# Provider selection
LLM_PROVIDER=cloudflare          # cloudflare | gemini | anthropic
SEARCH_PROVIDER=brave            # brave | anthropic
IMAGE_PROVIDER=cloudflare        # cloudflare | fal
MODE=free                        # free | paid (preset bundle)

# Free providers
BRAVE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_LLM_MODEL=            # optional; default: @cf/meta/llama-3.3-70b-instruct-fp8-fast

# Optional / legacy providers
GEMINI_API_KEY=                  # only required if LLM_PROVIDER=gemini

# Paid providers
ANTHROPIC_API_KEY=
FAL_KEY=

# Vercel KV (rate limit + cost cap)
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# Cost cap (paid mode only, USD per day)
DAILY_COST_CAP_USD=5
